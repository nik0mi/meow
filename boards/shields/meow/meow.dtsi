#include "meow-layouts.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,physical-layout = &physical_layout_meow;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
    };

    matrix_transform0: matrix_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <17>;
        rows = <2>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            RC(0,15) RC(0,16)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)
            RC(1,15) RC(1,16)
        >;
    };
};

&physical_layout_meow {
    transform = <&matrix_transform0>;
};
