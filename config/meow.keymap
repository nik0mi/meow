#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    flavor = "balanced";
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "Homerow_Mods_Left";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        ht: my_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "My_Hold_Tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            require-prior-idle-ms = <130>;
            flavor = "tap-preferred";
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "Homerow_Mods_Right";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };

        l2: l2 {
            compatible = "zmk,behavior-hold-tap";
            label = "L2";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <175>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <1 0>;
            layers = <0 1>;
            require-prior-idle-ms = <100>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        game_m {
            bindings = <&kp M>;
            key-positions = <4 24>;
            layers = <1>;
        };

        game_g {
            bindings = <&kp G>;
            key-positions = <14 4>;
            layers = <1>;
        };

        game_b {
            bindings = <&kp B>;
            key-positions = <14 24>;
            layers = <1>;
        };

        gaming {
            bindings = <&tog 1>;
            key-positions = <32 31>;
            layers = <0 1>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <21 20>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp Q  &kp W             &kp E             &kp R                 &kp T           &kp Y        &kp U                 &kp I             &kp O             &kp P
&kp A  &hm_l LEFT_ALT S  &hm_l LEFT_GUI D  &hm_l LEFT_CONTROL F  &kp G           &kp H        &hm_r LEFT_CONTROL J  &hm_r LEFT_GUI K  &hm_r LEFT_ALT L  &ht SQT SEMICOLON
&kp Z  &kp X             &kp C             &kp V                 &kp B           &kp N        &kp M                 &kp COMMA         &kp PERIOD        &ht RIGHT_BRACKET LEFT_BRACKET
                                           &l2 3 SPACE           &kp LEFT_SHIFT  &lt 4 ENTER  &kp BACKSPACE
            >;
        };

        GAME {
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E      &kp R             &kp Y            &kp U          &kp I      &kp O       &kp P
&kp LEFT_SHIFT    &kp A  &kp S  &kp D      &kp F             &kp H            &kp J          &kp K      &kp L       &ht SQT SEMICOLON
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C      &hm_l LEFT_ALT V  &kp N            &kp M          &kp COMMA  &kp PERIOD  &ht RIGHT_BRACKET LEFT_BRACKET
                                &kp SPACE  &mo 2             &ht TILDE GRAVE  &kp BACKSPACE
            >;
        };

        GAME_SYM {
            bindings = <
&trans  &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp F1  &kp F2   &kp F3   &kp F4   &trans
&trans  &trans  &trans  &trans        &kp NUMBER_3  &kp F5  &kp F6   &kp F7   &kp F8   &trans
&trans  &trans  &trans  &kp N5        &kp NUMBER_4  &kp F9  &kp F10  &kp F11  &kp F12  &trans
                        &none         &none         &none   &none
            >;
        };

        SYM {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT   &kp CARET    &kp AMPERSAND         &kp ASTERISK           &ht TILDE GRAVE               &ht BACKSLASH PIPE
&kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp EQUAL    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &ht LESS_THAN LEFT_BRACE      &ht UNDERSCORE KP_MINUS
&kp NUMBER_0     &kp NUMBER_9  &kp NUMBER_8  &kp NUMBER_7  &kp NUMBER_6  &kp KP_PLUS  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &ht GREATER_THAN RIGHT_BRACE  &ht QMARK FSLH
                                             &trans        &trans        &trans       &trans
            >;
        };

        SPECIAL {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &tog 5          &mmv MOVE_LEFT  &mmv MOVE_DOWN     &mmv MOVE_UP     &mmv MOVE_RIGHT  &mkp LCLK
&kp F5  &kp F6   &kp F7   &kp F8   &msc SCRL_UP    &kp LEFT_ARROW  &kp DOWN_ARROW     &kp UP_ARROW     &kp RIGHT_ARROW  &mkp RCLK
&kp F9  &kp F10  &kp F11  &kp F12  &msc SCRL_DOWN  &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT       &kp C_PLAY_PAUSE
                          &trans   &trans          &trans          &trans
            >;
        };

        OTHER {
            bindings = <
&none           &none  &none  &none  &tog 5       &none        &none  &none  &none  &none
&studio_unlock  &none  &none  &none  &bootloader  &bootloader  &none  &none  &none  &studio_unlock
&none           &none  &none  &none  &none        &none        &none  &none  &none  &none
                              &none  &none        &none        &none
            >;
        };
    };
};
